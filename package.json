{
  "name": "sports-score-system",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "bun lint --no-script",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "spell": "cspell --no-progress .",
    "docs:api": "typedoc",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@app/ui-components": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "cspell": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-jsdoc": "^65.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "turbo": "^2.11.11",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
